{
  "name": "pulse-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Pulse - Crystal cold-storage temperature monitoring dashboard (live WebSocket feed from the plant collector, Supabase/Postgres as the record and the fallback)",
  "scripts": {
    "dev": "node server.js --dev",
    "build": "next build",
    "start": "node server.js",
    "db:inspect": "node --env-file=.env.local scripts/db-inspect.js",
    "db:check": "node --env-file=.env.local scripts/db-check.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:integration": "node --test \"test-integration/**/*.test.js\"",
    "start:next": "next start -p 3000"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
