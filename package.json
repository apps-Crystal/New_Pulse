{
  "name": "pulse-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Pulse - Crystal cold-storage temperature monitoring dashboard (Supabase/Postgres data source)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:inspect": "node --env-file=.env.local scripts/db-inspect.js",
    "db:check": "node --env-file=.env.local scripts/db-check.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:integration": "node --test \"test-integration/**/*.test.js\""
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
