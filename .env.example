# Pulse - Supabase / Postgres data source
# Copy this file to .env.local and fill in the password.
#
# Direct connection (IPv6 only - works from this plant PC, which has IPv6):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.pyrulkcujxvioxijvtlx.supabase.co:5432/postgres
#
# If your network has no IPv6 (or on Vercel), use the Supabase pooler instead. This project's pooler is
# in ap-southeast-1. Port 5432 = session mode (long-running server), 6543 = transaction mode (serverless):
# DATABASE_URL=postgresql://postgres.pyrulkcujxvioxijvtlx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Browser poll interval in ms (build-time value; default 2000). Use 10000 on Vercel.
# NEXT_PUBLIC_POLL_MS=10000

# ---- Optional overrides (auto-detected when omitted; run `npm run db:inspect` to see what was found) ----
# PULSE_SCHEMA=public
# PULSE_TABLE=temperature_readings
# PULSE_MODE=long            # long | per_room | wide
# PULSE_ROOM_COL=room
# PULSE_TEMP_COL=temperature
# PULSE_TS_COL=recorded_at
# PULSE_SET_LOW_COL=set_low
# PULSE_SET_HIGH_COL=set_high
# Operator set-points (degrees C) when the table has no low/high columns (the plant table public.readings
# has none). Compact "zone=low:high,..." (either side may be empty; "frozen" / "chiller" / "other" / "*" set
# type-wide defaults) or JSON. Wins over the setpoints.json file; DB columns win over both. Read at startup.
# PULSE_SETPOINTS=frozen=-25:-15,chiller=0:8,dock_area=5:18
# PULSE_SETPOINTS_FILE=./setpoints.json
# Wide tables only (one column per room): force the column -> zone mapping when the column names are
# not recognisable (e.g. thermocouple tags). Zones: frozen_room_1..5, frozen_anteroom, chiller_room_1..6,
# chiller_anteroom, blast_freezer_1..2, dock_area (aliases like fr1 / cr2 / bf1 also work).
# PULSE_WIDE_MAP=TC1=frozen_room_1,TC2=frozen_room_2,TC7=chiller_room_1

# Time zone of `timestamp without time zone` (and text) timestamps in the DB. Default UTC. If the logger
# writes plant wall-clock time (readings look hours in the future / rooms flip OFFLINE), set it:
# PULSE_TS_TZ=Asia/Kolkata

# History tables are read in tiers (index-friendly): the last max(2 x PULSE_STALE_MS, 15 min) first; the last
# N hours only when a zone is missing from that slice; the whole table only when the N-hour window is empty
# (logger down for days). Default 48 (or 2x PULSE_STALE_MS in hours if larger). 0 disables the tiers (unbounded).
# For big history tables create an index: CREATE INDEX ON <table> (<room_col>, <ts_col> DESC);
# (public.readings on the plant database already has readings_tag_ts_idx (tag, ts DESC).)
# PULSE_WINDOW_HOURS=48

# A room whose newest reading is older than this is shown as OFFLINE (ms). Default 10 minutes.
# PULSE_STALE_MS=600000
# Server-side cache for /api/plc so many kiosk tabs don't multiply DB queries (ms). Default 1500.
# PULSE_CACHE_MS=1500
# TLS: Supabase requires SSL. Default does not verify the server certificate. Set a CA file to verify.
# PULSE_SSL_CA=./supabase-ca.crt
